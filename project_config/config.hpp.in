#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_CXX_STD _MSVC_LANG
#else
#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_CXX_STD __cplusplus
#endif

#if ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_CXX_STD >= 202302L
