/*! See ${%%CPP_INIT_REPLACE%%_PROJECT_NAME}::sys::Compiler for possible values of ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_*
 *
 *   NOTE: This value is derived from the global cmake cxx compiler setting, if different parts of
 *         the project are compiler with different compilers, this will not be reflected here.
 */
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_${CMAKE_CXX_COMPILER_ID}
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION "${CMAKE_CXX_COMPILER_VERSION}"
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_MAJOR ${%%CPP_INIT_REPLACE%%_COMPILER_VERSION_MAJOR}
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_MINOR ${%%CPP_INIT_REPLACE%%_COMPILER_VERSION_MINOR}
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_PATCH ${%%CPP_INIT_REPLACE%%_COMPILER_VERSION_PATCH}
#define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_TWEAK ${%%CPP_INIT_REPLACE%%_COMPILER_VERSION_TWEAK}

#if    defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_AppleClang)                                                       \
    || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_ARMClang)  || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_Clang)        \
    || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_CrayClang) || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_FujitsuClang) \
    || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_XLClang)   || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IBMClang)

#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_CLANG_LIKE 1
#else

#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_CLANG_LIKE 0

#endif

#if ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_CLANG_LIKE || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_GNU)
#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_GNU_LIKE 1
#else
#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_GNU_LIKE 0
#endif

#if defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_Intel) || defined(${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IntelLLVM)
#    define ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_ICC_LIKE 1
