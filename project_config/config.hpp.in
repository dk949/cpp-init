namespace ${%%CPP_INIT_REPLACE%%_PROJECT_NAME} {

namespace sys {
    enum struct Os : unsigned char {
        ADSP, AIX, Android, ARTOS, BeOS, BlueGeneL, BlueGeneP_dynamic,
        BlueGeneP_static, BlueGeneQ_dynamic, BlueGeneQ_static, BSDOS,
        Catamount, CrayLinuxEnvironment, CYGWIN, Darwin, DOS, DragonFly,
        eCos, Emscripten, Euros, FreeBSD, Fuchsia, Generic_ADSP, Generic_ELF,
        Generic, GHS_MULTI, GNU, Haiku, HP_UX, iOS, kFreeBSD, Linux, Midipix,
        MirBSD, MP_RAS, MSYS, NetBSD, OpenBSD, OpenVMS, OS2, OSF1, QNX,
        RISCos, SCO_SV, SerenityOS, SINIX, SunOS, syllable, Tru64, tvOS,
        ULTRIX, UNIX_SV, UnixWare, visionOS, watchOS, Windows, WindowsCE,
        WindowsPhone, WindowsStore, Xenix
    };

    inline constexpr auto os = Os::${%%CPP_INIT_REPLACE%%_SYSTEM_NAME_SANITISED};
    inline constexpr std::string_view os_str = "${%%CPP_INIT_REPLACE%%_SYSTEM_NAME_SANITISED}";
    inline constexpr auto is_unix = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_SYSTEM_IS_UNIX != 0;
    inline constexpr std::string_view version = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_SYSTEM_VERSION;
} // namespace sys

namespace compiler {
    enum struct Vendor : unsigned char {
        ADSP, AppleClang, ARMCC, ARMClang, Bruce, Clang, Cray,
        CrayClang, Embarcadero, Borland, Fujitsu, FujitsuClang,
        GNU, GHS, HP, IAR, Intel, IntelLLVM, LCC, MSVC, NVHPC,
        NVIDIA, OrangeC, OpenWatcom, PGI, PathScale, SDCC, SunPro,
        Tasking, TI, TinyCC, XL, VisualAge, zOS, XLClang, IBMClang,
    };

    inline constexpr auto vendor = Vendor::${CMAKE_CXX_COMPILER_ID};
    inline constexpr std::string_view vendor_str = "${CMAKE_CXX_COMPILER_ID}";
    inline constexpr auto is_clang_like = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_CLANG_LIKE != 0;
    inline constexpr auto is_gnu_like   = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_GNU_LIKE != 0;
    inline constexpr auto is_icc_like   = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_IS_ICC_LIKE != 0;

namespace version {
    inline constexpr std::string_view full = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION;
    inline constexpr int major = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_MAJOR;
    inline constexpr int minor = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_MINOR;
    inline constexpr int patch = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_PATCH;
    inline constexpr int tweak = ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_COMPILER_VERSION_TWEAK;
} // namespace version

} // namespace compiler

namespace lang {
    enum struct Std : unsigned char { Cxx98, Cxx03, Cxx11, Cxx14, Cxx17, Cxx20, Cxx23 };

    inline constexpr auto std =
#if ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX23
        Std::Cxx23
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX20
        Std::Cxx20
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX17
        Std::Cxx17
#endif
    ;

    inline constexpr auto std_num =
#if ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX23
        23
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX20
        20
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX17
        17
#endif
    ;

    inline constexpr std::string_view std_str =
#if ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX23
        "C++ 23"
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX20
        "C++ 20"
#elif ${%%CPP_INIT_REPLACE%%_PROJECT_NAME_CAPS}_HAS_STD_CXX17
        "C++ 17"
#endif
    ;
} // namespace lang

namespace version {
    inline constexpr std::string_view full = "${PROJECT_VERSION}";
    inline constexpr int major = ${PROJECT_VERSION_MAJOR};
    inline constexpr int minor = ${PROJECT_VERSION_MINOR};
    inline constexpr int patch = ${PROJECT_VERSION_PATCH};
} // namespace version

inline constexpr std::string_view name = "${PROJECT_NAME}";
inline constexpr std::string_view description = "${PROJECT_DESCRIPTION}";
inline constexpr std::string_view url = "${PROJECT_HOMEPAGE_URL}";
}  // namespace ${%%CPP_INIT_REPLACE%%_PROJECT_NAME}

#endif  // ${%%CPP_INIT_REPLACE%%_PROJECT_NAME}_CONFIG_HPP
